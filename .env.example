# Variables de entorno de TechAcademy BA.
#
# Este archivo es la documentación de la configuración: cópialo a `.env` solo si querés
# cambiar algún valor. Compose carga `.env` automáticamente, y todas las variables tienen
# un valor por defecto en docker-compose.yml, así que el entorno levanta sin este archivo.
#
# `.env` está en `.gitignore`. Este archivo no, a propósito.
#
# Ningún valor de acá es un secreto real. Los secretos usan placeholders obviamente falsos
# y hay que reemplazarlos antes de cualquier despliegue.

# ==========================================
# Backend — aplicación
# ==========================================

# Entorno de ejecución. Admitido: development, test, production.
APP_ENV=development

# Modo debug de la aplicación.
DEBUG=true

# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Zona horaria de fechas y horas del dominio. Fija por el equipo.
TIMEZONE=America/Argentina/Buenos_Aires

# ==========================================
# Backend — conexión a la base de datos
# ==========================================

# URL de conexión completa. docker-compose.yml la arma con POSTGRES_* cuando no está
# definida, usando el host `db`, que es el nombre del servicio dentro de la red de Compose.
# Si la definís acá, ese valor gana: es la variable que hay que tocar para apuntar a una
# base que no sea la del contenedor (D15, pruebas contra PostgreSQL).
DATABASE_URL=postgresql+psycopg://techacademy:techacademy@db:5432/techacademy

# ==========================================
# Backend — token de sesión (D2)
# ==========================================

# Secreto de firma del JWT. PLACEHOLDER: no es un secreto real. Generá uno propio con
# `python -c "import secrets; print(secrets.token_urlsafe(48))"` antes de desplegar.
JWT_SECRET_KEY=dev-only-insecure-placeholder-change-me

# Algoritmo de firma del token.
JWT_ALGORITHM=HS256

# Minutos de vigencia del token. 480 son ocho horas, una jornada laboral.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==========================================
# Backend — orígenes permitidos (CORS)
# ==========================================

# Orígenes del navegador que pueden llamar a la API, separados por coma. Es el origen del
# frontend de desarrollo, no el del contenedor: el navegador no ve los nombres de Compose.
CORS_ORIGINS=http://localhost:5173

# ==========================================
# Backend — correo (D17)
# ==========================================

# Implementación del envío. Admitido: log (solo registra, no contacta a nadie) y smtp.
# El proveedor real se elige más adelante; hoy no hay ninguno configurado.
EMAIL_BACKEND=log

# Las variables SMTP solo se usan con EMAIL_BACKEND=smtp. Se dejan vacías a propósito.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Remitente. El dominio .invalid está reservado por la RFC 2606 y nunca resuelve: es un
# placeholder que no puede enviar correo a nadie por accidente.
EMAIL_FROM=no-reply@techacademy.invalid
EMAIL_FROM_NAME=TechAcademy BA

# ==========================================
# Frontend
# ==========================================

# Qué implementación resuelve la fábrica de src/services (D13): mock o api.
# Con mock, todo el frontend anda con datos de ejemplo y solo el login pega al backend.
VITE_API_MODE=mock

# Prefijo de las llamadas a la API. El servidor de desarrollo de Vite hace proxy de /api
# hacia el backend (D14), así que este valor no cambia cuando aparezca la API real.
VITE_API_BASE_URL=/api

# Destino del proxy de /api en modo desarrollo.
VITE_API_PROXY_TARGET=http://backend:8000

# ==========================================
# Docker Compose
# ==========================================
#
# Solo las consume docker-compose.yml para interpolar ${...}. No las lee la aplicación.

# Base de datos.
POSTGRES_DB=techacademy
POSTGRES_USER=techacademy
POSTGRES_PASSWORD=techacademy

# Puertos publicados en el host, siempre atados a 127.0.0.1.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Vigilancia de archivos para la recarga automática de Vite. Docker Desktop sobre Windows y
# macOS no emite eventos en los bind mounts, así que el polling viene activado por defecto.
# Ponelo en false en Linux para ahorrar CPU.
CHOKIDAR_USEPOLLING=true